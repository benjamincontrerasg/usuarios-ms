              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "const error = pm.response.json();",
                  "pm.test(\"Formato uniforme de error\", function () {",
                  "    pm.expect(error.estado).to.eql(pm.response.code);",
                  "    pm.expect(error.mensaje).to.be.a(\"string\").and.not.empty;",
                  "    pm.expect(error.detalles).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Mensaje esperado\", function () { pm.expect(error.mensaje).to.eql(\"Datos de entrada invalidos\"); });",
                  "pm.test(\"Detalle de nombre\", function () { pm.expect(error.detalles.some(function (detalle) { return detalle.startsWith(\"nombre: \"); })).to.eql(true); });"
                ]
              }
            }
          ]
