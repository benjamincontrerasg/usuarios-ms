{
  "info": {
    "name": "RutaLimpia - Usuarios",
    "description": "CRUD y errores de Usuarios. Ejecutar toda la coleccion en orden, con PostgreSQL y Spring Boot iniciados. Crea dos usuarios con correos unicos y al terminar elimina solo esos IDs. Si se interrumpe, completar la carpeta 04 Limpieza antes de comenzar otra ejecucion. No contiene contrasenas ni datos reales.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "usuario_a_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "usuario_b_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "correo_a",
      "value": "",
      "type": "string"
    },
    {
      "key": "correo_b",
      "value": "",
      "type": "string"
    },
    {
      "key": "correo_actualizado",
      "value": "",
      "type": "string"
    },
    {
      "key": "correo_mayusculas",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Crear y consultar",
      "item": [
        {
          "name": "01 Crear usuario A y guardar ID",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \" Vecino Postman A \",\n  \"correo\": \" {{correo_a}} \",\n  \"telefono\": \" 912345678 \"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corrida = pm.variables.replaceIn(\"{{$guid}}\");",
                  "pm.collectionVariables.set(\"correo_a\", \"postman.a.\" + corrida + \"@example.com\");",
                  "pm.collectionVariables.set(\"correo_b\", \"postman.b.\" + corrida + \"@example.com\");",
                  "pm.collectionVariables.set(\"correo_actualizado\", \"postman.actualizado.\" + corrida + \"@example.com\");",
                  "pm.collectionVariables.set(\"usuario_a_id\", \"\");",
                  "pm.collectionVariables.set(\"usuario_b_id\", \"\");",
                  "pm.collectionVariables.set(\"correo_mayusculas\", pm.collectionVariables.get(\"correo_a\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const usuario = pm.response.json();",
                  "pm.test(\"Datos del usuario creado\", function () {",
                  "    pm.expect(usuario.id).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(usuario.nombre).to.eql(\"Vecino Postman A\");",
                  "    pm.expect(usuario.correo).to.eql(pm.collectionVariables.get(\"correo_a\"));",
                  "    pm.expect(usuario.telefono).to.eql(\"912345678\");",
                  "    pm.expect(usuario.rol).to.eql(\"VECINO\");",
                  "});",
                  "if (pm.response.code === 201 && Number.isInteger(usuario.id) && usuario.id > 0) {",
                  "    pm.collectionVariables.set(\"usuario_a_id\", String(usuario.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Crear usuario B sin telefono",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base_url}}/usuarios",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Vecino Postman B\",\n  \"correo\": \"{{correo_b}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "const usuario = pm.response.json();",
                  "pm.test(\"Datos del usuario creado\", function () {",
                  "    pm.expect(usuario.id).to.be.a(\"number\").and.above(0);",
                  "    pm.expect(usuario.nombre).to.eql(\"Vecino Postman B\");",
                  "    pm.expect(usuario.correo).to.eql(pm.collectionVariables.get(\"correo_b\"));",
                  "    pm.expect(usuario.telefono).to.eql(null);",
                  "    pm.expect(usuario.rol).to.eql(\"VECINO\");",
                  "});",
                  "if (pm.response.code === 201 && Number.isInteger(usuario.id) && usuario.id > 0) {",
                  "    pm.collectionVariables.set(\"usuario_b_id\", String(usuario.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "03 Listar y encontrar ambos usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const usuarios = pm.response.json();",
                  "pm.test(\"Lista contiene los usuarios creados\", function () {",
                  "    pm.expect(usuarios).to.be.an(\"array\");",
                  "    const ids = usuarios.map(function (usuario) { return String(usuario.id); });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"usuario_a_id\"));",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get(\"usuario_b_id\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Consultar usuario A",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/usuarios/{{usuario_a_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "const usuario = pm.response.json();",
                  "pm.test(\"Consulta recupera el usuario creado\", function () {",
                  "    pm.expect(String(usuario.id)).to.eql(pm.collectionVariables.get(\"usuario_a_id\"));",
                  "    pm.expect(usuario.correo).to.eql(pm.collectionVariables.get(\"correo_a\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
